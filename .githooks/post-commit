#!/bin/sh
#
# Post-commit hook: intentionally does NOT build or deploy anymore.
#
# Building the release APK and deploying it to https://leggio.kreilos.fr is now
# handled in the cloud by the GitHub Actions workflow
# .github/workflows/build-and-deploy.yml, which runs on every push to main.
# This keeps commits fast and makes CI the single source of published APKs.
#
# To build/deploy locally on demand you can still run:
#   flutter build apk --release
# which triggers the Gradle renameApk -> deployApk chain (a local copy into
# /var/www/prod/leggio, so it only works on the host that serves the site).

exit 0
